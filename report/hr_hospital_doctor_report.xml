<odoo>
    <record id="hr_hospital_doctor_report_action" model="ir.actions.report">
        <field name="name">Звіт доктора</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hospital.hr_hospital_doctor_report_template</field>
        <field name="report_file">hr_hospital.hr_hospital_doctor_report_template</field>
        <field name="print_report_name">'Лікар - %s' % object.name</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="hr_hospital_doctor_report_template" name="Doctor report">
        <t t-call="web.html_container">
            <t t-set="company" t-value="res_company"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="header">
                        <div class="d-flex align-items-center border-bottom pb-2">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="max-height: 60px;" alt="Logo" class="me-3"/>
                            <div>
                                <strong t-field="company.name"/>
                                <div t-field="company.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "phone", "email", "website"], "no_marker": true}'/>
                            </div>
                        </div>
                    </div>

                    <div class="page">
                        <h2>
                            <span t-field="o.name"/>
                            <t t-if="o.category_id">
                                — <span t-field="o.category_id.name"/>
                            </t>
                        </h2>
                        <h2>Історія візитів</h2>
                        <t
                                t-set="visits"
                                t-value="o.visit_ids.sorted(key=lambda v: v.visit_datetime or v.scheduled_datetime or v.create_date, reverse=True)"/>
                        <t t-set="status_styles" t-value="{
                            'scheduled': 'background-color: #ffc107; color: #000;',
                            'completed': 'background-color: #198754; color: #fff;',
                            'cancelled': 'background-color: #dc3545; color: #fff;',
                        }"/>
                        <t t-foreach="visits" t-as="visit">
                            <span
                                    t-out="visit.visit_datetime or visit.scheduled_datetime"
                                    t-options='{"widget": "datetime"}'/>
                            <span t-field="visit.patient_id.name"/>
                            <span
                                    t-att-style="status_styles.get(visit.status, '') + ' padding: 2px 6px; border-radius: 4px;'"
                                    t-field="visit.status"/>
                            <br/>
                        </t>
                        <h2>Пацієнти</h2>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>ПІБ</th>
                                    <th>Стать</th>
                                    <th>Дата народження</th>
                                    <th>Телефон</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.patient_ids" t-as="patient">
                                    <td><span t-field="patient.name"/></td>
                                    <td><span t-field="patient.gender"/></td>
                                    <td><span t-field="patient.birth_date"/></td>
                                    <td><span t-field="patient.phone"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div class="d-flex justify-content-between border-top pt-1 small">
                            <span>
                                Надруковано:
                                <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/>
                            </span>
                            <span>
                                <t t-out="res_company.city"/>
                            </span>
                            <span>
                                Стор.
                                <span class="page"/>
                                /
                                <span class="topage"/>
                            </span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>