<odoo>
    <record id="hr_hospital_disease_demo_respiratory" model="hr.hospital.disease">
        <field name="name">Respiratory Infections</field>
    </record>
    <record id="hr_hospital_disease_demo_cold" model="hr.hospital.disease">
        <field name="name">Common Cold</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_respiratory"/>
    </record>
    <record id="hr_hospital_disease_demo_runny_nose" model="hr.hospital.disease">
        <field name="name">Runny Nose</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_cold"/>
    </record>
    <record id="hr_hospital_disease_demo_sore_throat" model="hr.hospital.disease">
        <field name="name">Pharyngitis</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_respiratory"/>
    </record>
    <record id="hr_hospital_disease_demo_cough" model="hr.hospital.disease">
        <field name="name">Mild Cough</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_respiratory"/>
    </record>
</odoo>
