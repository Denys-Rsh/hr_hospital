<odoo>
    <record id="hr_hospital_disease_list" model="ir.ui.view">
        <field name="name">hr.hospital.disease.list ()</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent_id" />
                <field name="child_ids" />
            </list>
        </field>
    </record>

    <record id="hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form ()</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="parent_id" />
                            <field name="child_ids" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_disease_action" model="ir.actions.act_window">
        <field name="name">Disease</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_disease_menu"
              name="Diseases"
              parent="hr_hospital_main_menu"
              action="hr_hospital_disease_action"/>
</odoo>