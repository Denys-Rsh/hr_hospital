<odoo>
    <record id="hr_hospital_disease_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.report.wizard.form</field>
        <field name="model">hr.hospital.disease.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="doctor_ids" />
                        <field name="disease_ids" />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>
                <footer>
                    <button name="action_show_report" type="object" string="Сформувати" class="btn-primary" />
                    <button special="cancel" string="Скасувати" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_disease_report_wizard_doctor_action" model="ir.actions.act_window">
        <field name="name">Звіт по хворобах</field>
        <field name="res_model">hr.hospital.disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor" />
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="hr_hospital_disease_report_wizard_disease_action" model="ir.actions.act_window">
        <field name="name">Звіт по хворобах</field>
        <field name="res_model">hr.hospital.disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_disease" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
