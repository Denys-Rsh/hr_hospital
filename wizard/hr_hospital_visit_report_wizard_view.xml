<odoo>
    <record id="hr_hospital_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.report.wizard.form ()</field>
        <field name="model">hr.hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags" />
                        <field name="patient_ids" widget="many2many_tags" />
                        <field name="disease_id" />
                    </group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="only_completed" />
                    </group>
                </group>
                <footer>
                    <button name="action_show_report" type="object" string="Generate" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_report_wizard_patient_action" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient" />
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hr_hospital_doctor_group'))]" />
    </record>

    <record id="hr_hospital_visit_report_wizard_doctor_action" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor" />
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hr_hospital_doctor_group'))]" />
    </record>
</odoo>
