<odoo>
    <record id="hr_hospital_mass_reassign_doctor_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.mass.reassign.doctor.wizard.form ()</field>
        <field name="model">hr.hospital.mass.reassign.doctor.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="patient_ids" widget="many2many_tags" />
                    <field name="doctor_id" />
                    <field name="changing_date" />
                </group>
                <footer>
                    <button name="action_reassign" type="object" string="Призначити" class="btn-primary" />
                    <button special="cancel" string="Скасувати" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_mass_reassign_doctor_wizard_action" model="ir.actions.act_window">
        <field name="name">Візард масового перевизначення персонального лікаря для пацієнтів</field>
        <field name="res_model">hr.hospital.mass.reassign.doctor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>